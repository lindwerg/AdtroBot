DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/adtrobot
DEBUG=true
LOG_LEVEL=DEBUG
PORT=8000

# Telegram Bot
TELEGRAM_BOT_TOKEN=your_bot_token_from_@BotFather
WEBHOOK_BASE_URL=https://your-app.railway.app
WEBHOOK_SECRET=generate_random_32_chars_secret

# OpenRouter AI
OPENROUTER_API_KEY=your_openrouter_api_key

# YooKassa Payments
YOOKASSA_SHOP_ID=your_shop_id
YOOKASSA_SECRET_KEY=your_secret_key
YOOKASSA_RETURN_URL=https://t.me/YourBotName

# Admin Panel
ADMIN_JWT_SECRET=generate_random_32_chars_secret
ADMIN_JWT_EXPIRE_MINUTES=30

# CORS (comma-separated URLs for production)
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# GeoNames (register at geonames.org)
GEONAMES_USERNAME=your_username
